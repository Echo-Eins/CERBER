{
  "seed": 42,
  "num_epochs": 50,
  "batch_size": 32,
  "num_workers": 4,
  "log_every": 50,
  "checkpoint_every_epochs": 10,
  "rolling_checkpoint_name": "latest_epoch.pt",
  "eval_every_epochs": 2,

  "train_data_path": "data/wikitext_sonar_10k.pt",
  "val_data_path": "",
  "output_dir": "experiments/03_Stage_1.5",
  "checkpoint_dir": "experiments/03_Stage_1.5/checkpoints",
  "logs_dir": "experiments/03_Stage_1.5/logs",

  "energy_dim": 1024,
  "energy_hidden_dims": [2048, 1024, 512],
  "actor_hidden_dims": [2048, 1024, 512],
  "norm_mode": "orthonorm",
  "activation": "groupsort",
  "actor_norm_mode": "orthonorm",
  "actor_activation": "groupsort",
  "ortho_n_iters": 4,
  "ortho_schedule_enabled": true,
  "ortho_schedule_iters": [4, 2, 2],
  "ortho_schedule_boundaries": [0.34, 0.67],
  "twin_aggregate": "softmax",
  "twin_softmax_temperature": 0.30,

  "critic_lr": 0.0001,
  "actor_lr": 0.00005,
  "prior_critic_lr": 0.0001,
  "weight_decay": 0.01,
  "clip_grad_norm": 1.0,
  "critic_steps_per_actor": 2,

  "lambda_mdsm": 0.0,
  "mdsm_warmup_epochs": 0,
  "mdsm_directional": false,
  "lambda_rank": 1.0,
  "lambda_nce": 0.10,
  "lambda_cql": 0.1,
  "lambda_shell": 0.1,
  "lambda_geo": 1.0,
  "lambda_align": 0.1,
  "lambda_bc_reg": 0.5,
  "lambda_prior": 0.1,
  "lambda_prior_nce": 0.05,
  "lambda_actor_barrier": 0.2,
  "lambda_actor_descent": 0.1,
  "lambda_clean_min": 0.05,
  "clean_min_margin": 0.1,
  "lambda_direction": 0.0,
  "direction_num_samples": 0,
  "lambda_support": 0.1,
  "support_k": 5,
  "support_threshold_percentile": 95.0,
  "lambda_inbatch_nce": 0.15,
  "inbatch_nce_temperature": 0.07,

  "use_cql": true,
  "use_nce": true,
  "use_bc": true,
  "use_grad_align": true,
  "use_prior_critic": false,
  "use_prior_nce": false,
  "use_gradient_penalty": false,
  "use_shell_barrier": false,
  "use_clean_min_penalty": true,
  "use_direction_loss": false,
  "use_support_penalty": true,
  "use_inbatch_negatives": true,
  "use_energy_reg": false,
  "lambda_energy_reg": 0.0,

  "gradient_penalty_lambda": 0.05,
  "shell_barrier_margin": 0.1,
  "cql_noise_scale": 0.5,
  "nce_temperature": 0.07,
  "nce_num_random_negatives": 4,

  "sigma_curriculum_start": 0.01,
  "sigma_curriculum_end": 0.30,
  "sigma_min": 0.01,
  "sigma_max": 0.30,
  "sigma_sampling": "loguniform",
  "sigma_weighting": "sigma2",
  "edm_p_mean": -1.2,
  "edm_p_std": 1.2,
  "mdsm_tangent_projection": true,
  "mdsm_directional": true,
  "mdsm_magnitude_aux_weight": 0.05,
  "mdsm_cosine_eps": 0.0001,
  "mdsm_norm_floor": 0.0001,
  "mdsm_force_fp32": true,
  "mdsm_gradient_checkpointing": true,

  "critic_margin_clean_actor": 0.1,
  "critic_margin_actor_noisy": 0.05,
  "critic_margin_clean_noisy": 0.15,
  "rank_normalize_by_std": true,
  "rank_std_floor": 0.01,
  "actor_energy_margin_pos": 0.05,
  "actor_energy_margin_hard": 0.05,
  "actor_barrier_normalize_by_std": true,

  "actor_step_size": 0.3,
  "actor_tangent_projection": true,
  "actor_seed_mix_query": 0.5,
  "actor_seed_noise_scale": 1.0,
  "actor_eval_steps": 3,
  "critic_eval_langevin_steps": 10,
  "eval_langevin_batch_size": 16,
  "eval_noise_scales": [0.05, 0.1, 0.2, 0.3],

  "retrieval_bank_size": 2048,
  "retrieval_topk_pos": 6,
  "retrieval_hard_start": 6,
  "retrieval_hard_end": 24,
  "retrieval_self_sim_exclude": 0.9995,
  "retrieval_min_pos_similarity": 0.15,
  "retrieval_strict_index_exclusion": true,

  "amp_enabled": true,
  "amp_dtype": "bf16",
  "enable_compile": false,
  "compile_mode": "reduce-overhead",
  "compile_fullgraph": false,
  "eval_num_samples": 64,
  "langevin_tangent_noise": true,

  "min_cosine_improvement": 0.05,
  "min_cosine_success_rate": 0.6,
  "min_geodesic_improvement": 0.01,
  "min_l2_improvement": 0.0,
  "min_energy_success_rate": 0.55,
  "max_clean_min_violation_rate": 0.1,
  "min_step_norm": 1e-6,

  "skip_non_finite_batches": true,
  "non_finite_backoff_streak_trigger": 3,
  "non_finite_lr_backoff": 0.5,
  "max_consecutive_non_finite_batches": 10,
  "guard_loss_spikes": true,
  "loss_spike_factor": 20.0,
  "loss_spike_warmup_steps": 25,
  "param_finite_check_interval": 50,

  "langevin": {
    "method": "pid",
    "target_norm": 0.2051,
    "lr": 0.001,
    "noise_scale": 0.0002,
    "max_steps": 100,
    "pid_kp": 0.1,
    "pid_ki": 0.01,
    "pid_kd": 0.05,
    "pid_integral_decay": 0.95,
    "sigma_anneal": true,
    "sigma_anneal_mode": "hybrid",
    "sigma_anneal_max": 0.3,
    "sigma_anneal_min": 0.01,
    "sigma_anneal_blend": 0.5,
    "noise_anneal": true,
    "noise_anneal_mode": "hybrid",
    "noise_anneal_max": 0.15,
    "noise_anneal_min": 0.0002,
    "noise_anneal_sync_with_sigma": true
  }
}
