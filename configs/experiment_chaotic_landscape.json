{
  "_description": "Chaotic Landscape Experiment: recreate sharp canyon/ring energy topology from unconstrained MLPs within twin critic + actor architecture. Hypothesis: sharp V-shaped energy landscapes provide better gradient signal for Langevin navigation than smooth plateaus.",
  "_changes_from_baseline": [
    "ReLU activation on critics (sharp gradients, dead zones = canyons)",
    "Removed energy output clamp (allow unbounded energy peaks/valleys)",
    "Disabled energy regularization (allow natural energy scale growth)",
    "Disabled energy floor (allow deep wells = canyon bottoms)",
    "Disabled clean_min penalty (allow sub-clean attractors)",
    "Reduced CD (less smoothing of landscape)",
    "Enabled tamed gradient in Langevin (safety net for large gradients)",
    "Reduced max Langevin steps to 42 (sweet spot from experiments)",
    "Aggressive plateau patience for early stopping"
  ],

  "seed": 42,
  "num_epochs": 50,
  "batch_size": 32,
  "num_workers": 4,
  "log_every": 50,
  "checkpoint_every_epochs": 5,
  "rolling_checkpoint_name": "latest_epoch.pt",
  "eval_every_epochs": 2,

  "train_data_path": "data/wikitext_sonar_10k.pt",
  "val_data_path": "",
  "output_dir": "experiments/04_chaotic_landscape",
  "checkpoint_dir": "experiments/04_chaotic_landscape/checkpoints",
  "logs_dir": "experiments/04_chaotic_landscape/logs",

  "energy_dim": 1024,
  "energy_hidden_dims": [2048, 1024, 512],
  "critic_architecture": "radial_angular",
  "angular_hidden_dims": [2048, 1024, 512],
  "radial_hidden_dims": [512, 256, 128],
  "actor_hidden_dims": [2048, 1024, 512],

  "_activation_rationale": "ReLU creates sharp transitions and dead zones = canyon walls. SiLU smooths everything into plateaus.",
  "norm_mode": "none",
  "activation": "relu",
  "angular_norm_mode": "none",
  "angular_activation": "relu",
  "radial_norm_mode": "none",
  "radial_activation": "relu",
  "actor_norm_mode": "none",
  "actor_activation": "silu",

  "_clamp_rationale": "No output clamp = allow arbitrarily sharp energy peaks and deep valleys. The tamed gradient in Langevin handles safety.",
  "angular_energy_output_clamp": null,
  "radial_energy_output_clamp": null,

  "ortho_n_iters": 2,
  "ortho_schedule_enabled": false,
  "ortho_schedule_iters": [2],
  "ortho_schedule_boundaries": [],
  "twin_aggregate": "softmax",
  "twin_softmax_temperature": 0.3,
  "sigma_head_weighting_enabled": true,
  "angular_weight_low_sigma": 0.65,
  "angular_weight_high_sigma": 0.80,
  "head_weight_power": 1.0,

  "critic_lr": 0.001,
  "actor_lr": 0.0003,
  "prior_critic_lr": 0.001,
  "weight_decay": 0.01,
  "clip_grad_norm": 1.0,
  "critic_steps_per_actor": 2,
  "critic_step_mode": "joint",

  "lambda_mdsm": 0.5,
  "lambda_mdsm_angular": 0.5,
  "lambda_mdsm_radial": 0.2,
  "mdsm_warmup_epochs": 5,
  "lambda_rank": 1.0,
  "lambda_rank_angular": 1.0,
  "lambda_rank_radial": 0.5,
  "lambda_nce": 0.0,
  "lambda_cql": 0.0,
  "lambda_shell": 0.0,
  "lambda_geo": 1.0,
  "lambda_align": 0.1,
  "lambda_bc_reg": 0.3,
  "lambda_prior": 0.0,
  "lambda_prior_nce": 0.0,
  "lambda_actor_barrier": 0.1,
  "lambda_actor_descent": 0.1,

  "_clean_min_rationale": "DISABLED. We WANT deep wells below clean energy = canyon bottoms where target lives.",
  "lambda_clean_min": 0.0,
  "lambda_clean_min_angular": 0.0,
  "lambda_clean_min_radial": 0.0,
  "clean_min_margin": 0.1,

  "lambda_direction": 0.3,
  "lambda_direction_angular": 0.3,
  "lambda_direction_radial": 0.0,
  "direction_num_samples": 1,
  "lambda_angular_purity": 0.05,
  "lambda_radial_purity": 0.05,
  "lambda_head_corr": 0.02,
  "head_corr_target": 0.2,
  "lambda_support": 0.0,
  "support_k": 5,
  "support_threshold_percentile": 95.0,
  "lambda_inbatch_nce": 0.0,
  "inbatch_nce_temperature": 0.07,

  "use_cql": false,
  "use_nce": false,
  "use_bc": true,
  "use_grad_align": true,
  "use_prior_critic": false,
  "use_prior_nce": false,
  "use_gradient_penalty": false,
  "use_shell_barrier": false,
  "use_clean_min_penalty": false,
  "use_direction_loss": true,
  "route_cd_to_radial_only": false,
  "route_energy_floor_to_radial_only": false,
  "route_direction_to_angular_only": true,
  "route_clean_min_to_radial_only": false,
  "use_support_penalty": false,
  "use_inbatch_negatives": false,

  "_energy_reg_rationale": "DISABLED. Let energy scale grow freely = sharper landscape features.",
  "use_energy_reg": false,
  "lambda_energy_reg": 0.0,
  "energy_scale_trainable": true,
  "energy_scale_init_log": 0.0,
  "energy_scale_lr_multiplier": 0.5,
  "lambda_energy_scale_reg": 0.0,
  "energy_reg_universal": false,
  "energy_reg_actor_weight": 2.0,

  "_energy_floor_rationale": "DISABLED. No floor = allow arbitrarily deep energy wells (canyon bottoms).",
  "use_energy_floor": false,
  "lambda_energy_floor": 0.0,
  "energy_floor_threshold": 5.0,
  "energy_floor_relative_to_clean": true,
  "energy_floor_margin": 0.20,
  "energy_floor_sharpness": 2.0,
  "energy_floor_num_random": 64,
  "energy_floor_adversarial_steps": 4,
  "energy_floor_adversarial_lr": 0.01,

  "_cd_rationale": "Keep CD but reduced — still need SOME landscape shaping, just less smoothing.",
  "use_cd": true,
  "lambda_cd": 0.1,
  "cd_relative_to_clean": true,
  "cd_margin": 0.20,
  "cd_num_samples": 32,
  "cd_num_steps": 10,
  "cd_lr": 0.01,
  "cd_noise_scale": 0.001,
  "use_interp_gp": false,
  "lambda_interp_gp": 0.0,

  "gradient_penalty_lambda": 0.05,
  "shell_barrier_margin": 0.1,
  "cql_noise_scale": 0.5,
  "nce_temperature": 0.07,
  "nce_num_random_negatives": 4,

  "sigma_curriculum_start": 0.01,
  "sigma_curriculum_end": 0.3,
  "sigma_min": 0.01,
  "sigma_max": 0.3,
  "sigma_sampling": "loguniform",
  "sigma_weighting": "sigma2",
  "edm_p_mean": -1.2,
  "edm_p_std": 1.2,
  "mdsm_target_mode": "logspace",
  "mdsm_sigma_eff_floor_mode": "adaptive",
  "mdsm_sigma_eff_floor": 1e-10,
  "mdsm_sigma_floor": 1e-8,
  "mdsm_inv_sigma2_clip": 100000000.0,
  "mdsm_weight_floor": 1e-8,
  "mdsm_tangent_projection": true,
  "mdsm_directional": true,
  "mdsm_magnitude_aux_weight": 0.05,
  "mdsm_cosine_eps": 1e-4,
  "mdsm_norm_floor": 1e-6,
  "mdsm_force_fp32": true,
  "mdsm_gradient_checkpointing": true,

  "critic_margin_clean_actor": 0.1,
  "critic_margin_actor_noisy": 0.05,
  "critic_margin_clean_noisy": 0.15,
  "rank_normalize_by_std": false,
  "rank_std_floor": 0.01,
  "actor_energy_margin_pos": 0.05,
  "actor_energy_margin_hard": 0.05,
  "actor_barrier_normalize_by_std": false,

  "actor_step_size": 0.5,
  "actor_tangent_projection": true,
  "actor_seed_mix_query": 0.5,
  "actor_seed_noise_scale": 1.0,
  "actor_eval_steps": 3,
  "critic_eval_langevin_steps": 42,
  "eval_langevin_batch_size": 16,
  "eval_noise_scales": [0.05, 0.1, 0.15, 0.2],

  "retrieval_bank_size": 4096,
  "retrieval_topk_pos": 8,
  "retrieval_hard_start": 8,
  "retrieval_hard_end": 32,
  "retrieval_self_sim_exclude": 0.9995,
  "retrieval_min_pos_similarity": 0.15,
  "retrieval_strict_index_exclusion": true,

  "amp_enabled": true,
  "amp_dtype": "bf16",
  "enable_compile": false,
  "compile_mode": "reduce-overhead",
  "compile_fullgraph": false,
  "eval_num_samples": 128,
  "langevin_tangent_noise": true,

  "_kill_criteria_rationale": "Relaxed clean_min gate since we intentionally allow sub-clean wells.",
  "min_cosine_improvement": 0.06,
  "min_cosine_success_rate": 0.7,
  "min_geodesic_improvement": 0.02,
  "min_l2_improvement": 0.005,
  "min_energy_success_rate": 0.65,
  "max_clean_min_violation_rate": 1.0,
  "clean_min_violation_mode": "strict",
  "min_step_norm": 0.001,

  "skip_non_finite_batches": true,
  "non_finite_backoff_streak_trigger": 3,
  "non_finite_lr_backoff": 0.5,
  "max_consecutive_non_finite_batches": 10,
  "guard_loss_spikes": true,
  "loss_spike_factor": 20.0,
  "loss_spike_warmup_steps": 25,
  "param_finite_check_interval": 50,

  "langevin": {
    "method": "pid",
    "target_norm": 0.2051,
    "lr": 0.001,
    "noise_scale": 0.0002,
    "max_steps": 42,
    "pid_kp": 1.0,
    "pid_ki": 0.3,
    "pid_kd": 0.1,
    "pid_integral_decay": 0.95,
    "sigma_anneal": true,
    "sigma_anneal_mode": "hybrid",
    "sigma_anneal_max": 0.3,
    "sigma_anneal_min": 0.01,
    "sigma_anneal_blend": 0.5,
    "noise_anneal": true,
    "noise_anneal_mode": "hybrid",
    "noise_anneal_max": 0.15,
    "noise_anneal_min": 0.0002,
    "noise_anneal_sync_with_sigma": true,
    "mala_enabled": true,
    "mala_temperature_floor": 0.01,
    "mala_trust_radius": 10.0,
    "tamed": true,
    "plateau_patience": 15,
    "plateau_delta": 1e-4,
    "cosine_early_stop": true,
    "cosine_patience": 20,
    "cosine_delta": 0.001
  }
}
