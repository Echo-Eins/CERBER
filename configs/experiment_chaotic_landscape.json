{
  "_description": "Chaotic Landscape Experiment v2: recreate ring/canyon energy topology. Adapted from the old 2026-03-26 SOTA config that produced the desired well-shaped landscape. Key: groupsort (creates rings) + mild energy reg (prevents explosion) + CQL (shapes wells) + MDSM-dominant training.",
  "_changes_from_old_config": [
    "Mapped old homogeneous critic to twin radial_angular architecture",
    "Kept groupsort activation (creates ring topology naturally via 1-Lipschitz sorting)",
    "No orthonorm (too expensive) - using mild energy_reg + clamp instead",
    "Added CQL back (pushes up random-point energies = shapes wells)",
    "MDSM-dominant: lambda_mdsm=1.0, lambda_rank=0.25 (old balance)",
    "Large margins from old config (0.5/0.3/0.8)",
    "Higher Langevin noise_scale=0.05, lower PID gains (old config values)",
    "Disabled clean_min penalty (allow sub-clean wells = canyon bottoms)"
  ],

  "seed": 42,
  "num_epochs": 50,
  "batch_size": 32,
  "num_workers": 4,
  "log_every": 50,
  "checkpoint_every_epochs": 5,
  "rolling_checkpoint_name": "latest_epoch.pt",
  "eval_every_epochs": 2,

  "train_data_path": "data/wikitext_sonar_10k.pt",
  "val_data_path": "",
  "output_dir": "experiments/04_chaotic_landscape",
  "checkpoint_dir": "experiments/04_chaotic_landscape/checkpoints",
  "logs_dir": "experiments/04_chaotic_landscape/logs",

  "energy_dim": 1024,
  "energy_hidden_dims": [2048, 1024, 512],
  "critic_architecture": "radial_angular",
  "angular_hidden_dims": [2048, 1024, 512],
  "radial_hidden_dims": [512, 256, 128],
  "actor_hidden_dims": [2048, 1024, 512],

  "_activation_rationale": "GroupSort (MaxMin) is 1-Lipschitz by construction and creates ring/canyon topology naturally via sorting operations. Unlike ReLU it preserves gradient norms and doesn't cause exponential energy growth.",
  "norm_mode": "none",
  "activation": "groupsort",
  "angular_norm_mode": "none",
  "angular_activation": "groupsort",
  "radial_norm_mode": "none",
  "radial_activation": "groupsort",
  "actor_norm_mode": "none",
  "actor_activation": "silu",
  "groupsort_size": 2,

  "_clamp_rationale": "Moderate clamp as safety net. GroupSort keeps gradients bounded but weights can still grow without orthonorm.",
  "angular_energy_output_clamp": 50.0,
  "radial_energy_output_clamp": 50.0,

  "ortho_n_iters": 2,
  "ortho_schedule_enabled": false,
  "ortho_schedule_iters": [2],
  "ortho_schedule_boundaries": [],
  "twin_aggregate": "softmax",
  "twin_softmax_temperature": 0.10,
  "sigma_head_weighting_enabled": true,
  "angular_weight_low_sigma": 0.45,
  "angular_weight_high_sigma": 0.75,
  "head_weight_power": 1.0,

  "_optimizer_rationale": "Same LR as old config. Weight decay helps bound weights without orthonorm.",
  "critic_lr": 1e-4,
  "actor_lr": 5e-5,
  "prior_critic_lr": 1e-4,
  "weight_decay": 0.01,
  "clip_grad_norm": 1.0,
  "critic_steps_per_actor": 2,
  "critic_step_mode": "joint",

  "_loss_rationale": "MDSM-dominant from old config: lambda_mdsm=1.0, lambda_rank=0.25. MDSM teaches score field (gradient direction), ranking alone creates plateaus.",
  "lambda_mdsm": 1.0,
  "lambda_mdsm_angular": 1.0,
  "lambda_mdsm_radial": 0.3,
  "mdsm_warmup_epochs": 3,
  "lambda_rank": 0.25,
  "lambda_rank_angular": 0.25,
  "lambda_rank_radial": 0.15,
  "lambda_nce": 0.0,
  "lambda_cql": 0.1,
  "lambda_shell": 0.1,
  "lambda_geo": 1.0,
  "lambda_align": 0.1,
  "lambda_bc_reg": 0.5,
  "lambda_prior": 0.0,
  "lambda_prior_nce": 0.0,
  "lambda_actor_barrier": 0.1,
  "lambda_actor_descent": 0.1,

  "_clean_min_rationale": "DISABLED. Allow sub-clean energy wells = canyon bottoms where target lives.",
  "lambda_clean_min": 0.0,
  "lambda_clean_min_angular": 0.0,
  "lambda_clean_min_radial": 0.0,
  "clean_min_margin": 0.1,

  "lambda_direction": 0.1,
  "lambda_direction_angular": 0.1,
  "lambda_direction_radial": 0.0,
  "direction_num_samples": 1,
  "lambda_angular_purity": 0.05,
  "lambda_radial_purity": 0.05,
  "lambda_head_corr": 0.02,
  "head_corr_target": 0.2,
  "lambda_support": 0.0,
  "support_k": 5,
  "support_threshold_percentile": 95.0,
  "lambda_inbatch_nce": 0.0,
  "inbatch_nce_temperature": 0.07,

  "_feature_flags_rationale": "CQL enabled (shapes wells by pushing up random-point energy). Shell barrier enabled (ring enforcement).",
  "use_cql": true,
  "use_nce": false,
  "use_bc": true,
  "use_grad_align": true,
  "use_prior_critic": false,
  "use_prior_nce": false,
  "use_gradient_penalty": false,
  "use_shell_barrier": true,
  "use_clean_min_penalty": false,
  "use_direction_loss": true,
  "route_cd_to_radial_only": true,
  "route_energy_floor_to_radial_only": true,
  "route_direction_to_angular_only": true,
  "route_clean_min_to_radial_only": false,
  "use_support_penalty": false,
  "use_inbatch_negatives": false,

  "_energy_reg_rationale": "Mild regularization to prevent energy explosion without orthonorm. Just enough to keep scale bounded, not enough to create plateaus.",
  "use_energy_reg": true,
  "lambda_energy_reg": 0.01,
  "energy_scale_trainable": false,
  "energy_scale_init_log": 0.0,
  "energy_scale_lr_multiplier": 1.0,
  "lambda_energy_scale_reg": 0.0,
  "energy_reg_universal": false,
  "energy_reg_actor_weight": 2.0,

  "_energy_floor_rationale": "DISABLED. Allow deep wells = the canyons we want for Langevin navigation.",
  "use_energy_floor": false,
  "lambda_energy_floor": 0.0,
  "energy_floor_threshold": 5.0,
  "energy_floor_relative_to_clean": true,
  "energy_floor_margin": 0.15,
  "energy_floor_sharpness": 2.0,
  "energy_floor_num_random": 64,
  "energy_floor_adversarial_steps": 0,
  "energy_floor_adversarial_lr": 0.01,

  "_cd_rationale": "CD enabled — shapes landscape by pushing up Langevin endpoint energy. Moderate strength.",
  "use_cd": true,
  "lambda_cd": 0.1,
  "cd_relative_to_clean": true,
  "cd_margin": 0.15,
  "cd_num_samples": 32,
  "cd_num_steps": 10,
  "cd_lr": 0.01,
  "cd_noise_scale": 0.001,
  "use_interp_gp": false,
  "lambda_interp_gp": 0.0,

  "gradient_penalty_lambda": 0.05,
  "shell_barrier_margin": 0.1,
  "cql_noise_scale": 0.5,
  "nce_temperature": 0.07,
  "nce_num_random_negatives": 4,

  "_margins_rationale": "Large margins from old config that produced well-shaped landscape. Forces clear energy separation between clean/actor/noisy.",
  "critic_margin_clean_actor": 0.5,
  "critic_margin_actor_noisy": 0.3,
  "critic_margin_clean_noisy": 0.8,
  "rank_normalize_by_std": false,
  "rank_std_floor": 0.01,
  "actor_energy_margin_pos": 0.05,
  "actor_energy_margin_hard": 0.05,
  "actor_barrier_normalize_by_std": false,

  "_sigma_rationale": "Wider sigma range from old config (max=1.0). Teaches critic to handle large displacements = creates sharper gradients at larger scales.",
  "sigma_curriculum_start": 0.01,
  "sigma_curriculum_end": 0.5,
  "sigma_min": 0.001,
  "sigma_max": 1.0,
  "sigma_sampling": "loguniform",
  "sigma_weighting": "sigma2",
  "edm_p_mean": -1.2,
  "edm_p_std": 1.2,
  "mdsm_target_mode": "logspace",
  "mdsm_sigma_eff_floor_mode": "adaptive",
  "mdsm_sigma_eff_floor": 1e-10,
  "mdsm_sigma_floor": 1e-8,
  "mdsm_inv_sigma2_clip": 100000000.0,
  "mdsm_weight_floor": 1e-8,
  "mdsm_tangent_projection": true,
  "mdsm_directional": true,
  "mdsm_magnitude_aux_weight": 0.05,
  "mdsm_cosine_eps": 1e-6,
  "mdsm_norm_floor": 1e-6,
  "mdsm_force_fp32": true,
  "mdsm_gradient_checkpointing": true,

  "actor_step_size": 1.0,
  "actor_tangent_projection": true,
  "actor_seed_mix_query": 0.5,
  "actor_seed_noise_scale": 1.0,
  "actor_eval_steps": 3,
  "critic_eval_langevin_steps": 42,
  "eval_langevin_batch_size": 16,
  "eval_noise_scales": [0.05, 0.1, 0.2, 0.3],

  "retrieval_bank_size": 4096,
  "retrieval_topk_pos": 8,
  "retrieval_hard_start": 8,
  "retrieval_hard_end": 32,
  "retrieval_self_sim_exclude": 0.9995,
  "retrieval_min_pos_similarity": 0.15,
  "retrieval_strict_index_exclusion": true,

  "amp_enabled": true,
  "amp_dtype": "bf16",
  "enable_compile": false,
  "compile_mode": "reduce-overhead",
  "compile_fullgraph": false,
  "eval_num_samples": 128,
  "langevin_tangent_noise": true,

  "_kill_criteria_rationale": "Relaxed clean_min gate (disabled). Otherwise standard gates.",
  "min_cosine_improvement": 0.05,
  "min_cosine_success_rate": 0.5,
  "min_geodesic_improvement": 0.01,
  "min_l2_improvement": 0.005,
  "min_energy_success_rate": 0.5,
  "max_clean_min_violation_rate": 1.0,
  "clean_min_violation_mode": "strict",
  "min_step_norm": 0.001,

  "skip_non_finite_batches": true,
  "non_finite_backoff_streak_trigger": 3,
  "non_finite_lr_backoff": 0.5,
  "max_consecutive_non_finite_batches": 10,
  "guard_loss_spikes": true,
  "loss_spike_factor": 20.0,
  "loss_spike_warmup_steps": 25,
  "param_finite_check_interval": 50,

  "langevin": {
    "_rationale": "From old config: higher noise (0.05), much lower PID gains (kp=0.1, ki=0.01, kd=0.05). Gentle exploration instead of aggressive gradient chasing.",
    "method": "pid",
    "target_norm": 0.2051,
    "lr": 0.001,
    "noise_scale": 0.05,
    "max_steps": 100,
    "pid_kp": 0.1,
    "pid_ki": 0.01,
    "pid_kd": 0.05,
    "pid_integral_decay": 0.95,
    "sigma_anneal": true,
    "sigma_anneal_mode": "hybrid",
    "sigma_anneal_max": 0.5,
    "sigma_anneal_min": 0.001,
    "sigma_anneal_blend": 0.5,
    "noise_anneal": true,
    "noise_anneal_mode": "hybrid",
    "noise_anneal_max": 0.15,
    "noise_anneal_min": 0.001,
    "noise_anneal_sync_with_sigma": true,
    "mala_enabled": true,
    "mala_temperature_floor": 0.01,
    "mala_trust_radius": 10.0,
    "tamed": true,
    "plateau_patience": 15,
    "plateau_delta": 1e-4,
    "cosine_early_stop": true,
    "cosine_patience": 20,
    "cosine_delta": 0.001
  }
}
