{
    "description": "Stage 2: Autoregressor (ContextEncoder + IPP + SurprisePredictor)",

    "context_encoder": {
        "d_model": 1024,
        "ssm_d_state": 64,
        "ssm_d_conv": 4,
        "ssm_expand": 2,
        "ssm_n_layers": 2,
        "ssm_dropout": 0.05,
        "n_global_heads": 8,
        "global_attn_dropout": 0.1,
        "surprise_top_k_pct": 0.05,
        "n_types": 3,
        "output_dim": 1024,
        "use_alibi": false
    },

    "ipp": {
        "mode": "mlp",
        "d_model": 1024,
        "d_context": 1024,
        "hidden_dims": [2048, 2048, 1024],
        "n_integration_steps": 50,
        "d_time": 256,
        "sigma_init": 0.05,
        "solver": "midpoint",
        "mlp_hidden_dims": [2048, 1024],
        "mlp_contrastive_weight": 0.1,
        "mlp_temperature": 0.07
    },

    "surprise": {
        "d_model": 1024,
        "ssm_d_state": 64,
        "ssm_d_conv": 4,
        "ssm_expand": 2,
        "ssm_n_layers": 2,
        "ssm_dropout": 0.0,
        "pred_hidden": 1024,
        "cos_loss_weight": 0.5,
        "threshold_mode": "percentile",
        "threshold_percentile": 95.0
    },

    "training": {
        "surprise_lr": 3e-4,
        "context_encoder_lr": 1e-4,
        "ipp_lr": 1e-4,
        "weight_decay": 0.01,
        "clip_grad_norm": 1.0,
        "batch_size": 32,
        "num_epochs": 50,
        "warmup_epochs": 3,
        "lr_min_factor": 0.01,

        "surprise_pretrain_epochs": 10,
        "freeze_surprise_after_pretrain": true,

        "target_norm": 0.2051,
        "eval_num_samples": 4,

        "eval_every_epochs": 2,
        "checkpoint_every_epochs": 5,
        "log_every": 50
    },

    "data": {
        "train_data_path": "data/squad_sequences.pt",
        "val_data_path": "",
        "train_val_split": 0.9,
        "max_seq_len": 64,
        "min_seq_len": 3,
        "num_workers": 4
    },

    "amp": {
        "enabled": true,
        "dtype": "bf16"
    },

    "output": {
        "output_dir": "experiments/08_autoregressor",
        "checkpoint_dir": "experiments/08_autoregressor/checkpoints",
        "logs_dir": "experiments/08_autoregressor/logs"
    },

    "seed": 42
}
