{
    "seed": 42,

    "generator": {
        "d_model": 1024,
        "n_heads": 8,
        "n_layers": 6,
        "dim_feedforward": 4096,
        "max_chain_len": 20,
        "dropout": 0.1,
        "target_norm": 0.2051,
        "loss_cosine_weight": 1.0,
        "loss_mse_weight": 0.1,
        "diffusion_timesteps": 64,
        "diffusion_beta_schedule": "cosine",
        "diffusion_noise_scale": 0.0,
        "prediction_type": "v",
        "cfg_dropout_prob": 0.1,
        "ffn_type": "swiglu",
        "norm_type": "ada_rmsnorm",
        "zero_init_residual": true,
        "use_layerscale": true,
        "layerscale_init": 1e-4,
        "residual_norm_clamp": 256.0,
        "aux_head_layers": [],
        "aux_head_hidden_dim": 1024,
        "aux_head_dropout": 0.0
    },

    "critic": {
        "angular": {
            "dim": 1024,
            "hidden_dims": [2048, 1024, 512],
            "activation": "silu",
            "dropout": 0.1,
            "use_layer_norm": true,
            "energy_output_clamp": 50.0,
            "include_context": true,
            "temperature": 0.07,
            "focal_gamma": 2.0,
            "num_negatives": 7
        },
        "radial": {
            "target_norm": 0.2051,
            "scale": 1.0
        },
        "lambda_radial": 5.0
    },

    "data": {
        "path": "data/hotpotqa_sonar.pt",
        "num_workers": 4
    },

    "training": {
        "batch_size": 32,
        "num_epochs": 50,
        "lr": 1e-4,
        "weight_decay": 5e-4,
        "warmup_epochs": 2,
        "lr_min_factor": 0.01,
        "clip_grad_norm": 1.0,

        "system1_epochs": 3,
        "system2_start_steps": 4,
        "max_chain_steps": 20,
        "horizon_schedule": [[2, 2], [3, 2], [4, 10], [5, 10]],

        "ff_symba_alpha": 2.0,
        "ff_head_cosine_weight": 1.0,
        "ff_head_mse_weight": 0.1,
        "ff_neg_sigma": 0.3,
        "ff_neg_schedule": {
            "shuffle_start": 5,
            "hard_start": 15
        },

        "model_ema_decay": 0.0,

        "free_run_temperature": 1.0,
        "free_run_noise_std": 0.0,
        "eval_free_run_noise_std": 0.0,
        "free_run_repeat_penalty": 0.15,
        "free_run_repeat_cos_threshold": 0.98,
        "free_run_repeat_ban_threshold": 0.995,
        "free_run_repeat_ban_retries": 3,

        "context_bank_size": 4,
        "answer_repeat_pad": 2,

        "enable_ffn_stats": true,

        "log_every": 50,
        "metrics_log_name": "chain_generator_ff_training.jsonl",
        "checkpoint_every": 3,
        "early_stop_patience": 20
    },

    "amp": {
        "enabled": true,
        "dtype": "bfloat16"
    },

    "output": {
        "output_dir": "experiments/13_chain_generator/output_ff",
        "checkpoint_dir": "experiments/13_chain_generator/output_ff/checkpoints",
        "logs_dir": "experiments/13_chain_generator/output_ff/logs"
    }
}
