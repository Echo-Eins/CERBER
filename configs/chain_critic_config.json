{
    "seed": 42,

    "critic": {
        "angular": {
            "dim": 1024,
            "hidden_dims": [2048, 1024, 512],
            "activation": "silu",
            "dropout": 0.1,
            "use_layer_norm": true,
            "energy_output_clamp": 50.0,
            "include_context": true,
            "temperature": 0.07,
            "focal_gamma": 2.0,
            "num_negatives": 7
        },
        "radial": {
            "target_norm": 0.2051,
            "scale": 1.0
        },
        "lambda_radial": 5.0
    },

    "data": {
        "path": "data/hotpotqa_sonar.pt",
        "num_workers": 4,
        "context_bank_size": 4
    },

    "training": {
        "batch_size": 32,
        "num_epochs": 30,
        "lr": 3e-4,
        "weight_decay": 1e-4,
        "warmup_epochs": 2,
        "lr_min_factor": 0.01,
        "clip_grad_norm": 1.0,
        "enable_hard_negatives": true,
        "hard_negatives_top_k": 2,
        "enable_generator_hard_negatives": true,
        "generator_hard_checkpoint": "experiments/13_chain_generator/output/checkpoints/best.pt",
        "generator_hard_steps": 20,
        "generator_hard_slots": 1,
        "generator_hard_max_pos_cos": 0.98,

        "log_every": 50,
        "checkpoint_every": 5,
        "early_stop_patience": 15
    },

    "amp": {
        "enabled": true,
        "dtype": "bfloat16"
    },

    "output": {
        "output_dir": "experiments/14_chain_critic/output",
        "checkpoint_dir": "experiments/14_chain_critic/output/checkpoints",
        "logs_dir": "experiments/14_chain_critic/output/logs"
    }
}
